<script>
import router from '@system.router'

export default {
  private: {
    padTop: 0,
    padBottom: 0,
    padSide: 0,
    fsTitle: 17,
    screenLine: ''
  },

  onShow() {
    const app = this.$app.$def
    this.padTop = app.padTop
    this.padBottom = app.padBottom
    this.padSide = app.padSide
    this.fsTitle = app.fsTitle
    this.screenLine = app.screenLine()
  },

  go(name) {
    this.$app.$def.tap()
    router.push({ uri: 'pages/' + name })
  }
}
</script>

