<template>
  <div class="page" style="padding-top: {{padTop}}px; padding-bottom: {{padBottom}}px; padding-left: {{padSide}}px; padding-right: {{padSide}}px">
    <scroll class="scroll" scroll-y="true" bounces="true">
      <div class="toptitle">
        <text class="t-title" style="font-size: {{fsTitle}}px">设置</text>
      </div>
      <div class="topnav">
        <text class="t-nav t-icon" @click="back">‹ 返回</text>
      </div>

      <text class="sec" style="font-size: 12px">交互</text>
      <div class="row">
        <div class="row-main">
          <text class="row-title" style="font-size: 16px">按键振动</text>
          <text class="row-sub" style="font-size: 12px">{{vib ? '按下时轻振一下' : '已关闭'}}</text>
        </div>
        <div class="seg">
          <div class="seg-btn" @click="flipVib"><text class="t-seg t-icon">‹</text></div>
          <text class="seg-val" style="font-size: 15px">{{vib ? '开' : '关'}}</text>
          <div class="seg-btn" @click="flipVib"><text class="t-seg t-icon">›</text></div>
        </div>
      </div>

      <text class="sec" style="font-size: 12px">界面留白</text>
      <div class="row">
        <div class="row-main">
          <text class="row-title" style="font-size: 16px">{{padName}}</text>
          <text class="row-sub" style="font-size: 12px">{{padHint}}</text>
        </div>
        <div class="seg">
          <div class="seg-btn" @click="flipPad(-1)"><text class="t-seg t-icon">‹</text></div>
          <text class="seg-val" style="font-size: 15px">{{padIdx}}</text>
          <div class="seg-btn" @click="flipPad(1)"><text class="t-seg t-icon">›</text></div>
        </div>
      </div>
      <text class="sec" style="font-size: 12px">{{padDetail}}</text>

      <div class="pill pill-quiet" @click="reset">
        <text class="t-pill" style="font-size: 16px">恢复默认设置</text>
      </div>
      <text class="sec" style="font-size: 12px">导出（便于备份，或发帖时贴出来）</text>
      <div class="pill" @click="exportCfg">
        <text class="t-pill" style="font-size: 16px">导出配置与用法（文本）</text>
      </div>
      <div class="card" if="{{cfgText}}">
        <text class="out" style="font-size: 12px">{{cfgText}}</text>
      </div>

      <div class="gap"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import { dropKey, loadKey } from '../../common/core/util'

export default {
  private: {
    padTop: 0,
    padBottom: 0,
    padSide: 0,
    fsTitle: 17,
    vib: true,
    padName: '全屏',
    padIdx: 1,
    padHint: '',
    padDetail: '',
    padTotal: 3,
    cfgText: ''
  },

  onShow() { this.sync() },

  // EXPORT_HERE
  /** 把设置与脚本/历史导成一段纯文本（手表上只能看，便于抄下来或拍照） */
  exportCfg() {
    const app = this.$app.$def
    app.tap()
    const self = this
    const lines = ['工具箱 · 配置与用法',
      '屏幕 ' + app.w + 'x' + app.h + ' · 形状 ' + app.shape,
      '留白 ' + this.padName + '（档 ' + this.padIdx + '/' + this.padTotal + '）',
      '按键振动 ' + (this.vib ? '开' : '关')]
    loadKey('tb_scripts', function (ok, v) {
      const sc = ok && v ? JSON.parse(v) : []
      lines.push('脚本 ' + sc.length + ' 条')
      for (let i = 0; i < sc.length; i++) lines.push('  $ ' + sc[i])
      loadKey('tb_hist', function (ok2, v2) {
        const h = ok2 && v2 ? JSON.parse(v2) : []
        lines.push('历史 ' + h.length + ' 条（最近 6 条）')
        for (let i = 0; i < h.length && i < 6; i++) lines.push('  $ ' + h[i])
        lines.push('后端：表盘位 Lua 应用，装后与界面端互通')
        lines.push('致谢：Shell++ 作者 IKUN_CXKPRO（米坛）')
        self.cfgText = lines.join('\n')
      })
    })
  },

  sync() {
    const app = this.$app.$def
    this.padTop = app.padTop
    this.padBottom = app.padBottom
    this.padSide = app.padSide
    this.fsTitle = app.fsTitle
    this.vib = app.vib
    this.padName = app.padName
    this.padIdx = app.padMode + 1
    this.padTotal = app.PAD_PRESETS.length
    this.padHint = app.padMode === 0 ? '铺满整屏，内容仍可上下滑动' : '上下左右都留出空间'
    this.padDetail = '当前留白：上 ' + app.padTop + ' · 下 ' + app.padBottom + ' · 侧 ' + app.padSide + ' px（屏宽 ' + app.w + '）'
  },

  flipVib() {
    const app = this.$app.$def
    app.tap()
    app.setVib(!app.vib)
    this.vib = app.vib
  },

  flipPad(d) {
    const app = this.$app.$def
    app.tap()
    let i = app.padMode + d
    if (i < 0) i = app.PAD_PRESETS.length - 1
    if (i >= app.PAD_PRESETS.length) i = 0
    app.setPad(i, false)
    this.sync()
  },

  reset() {
    const app = this.$app.$def
    app.tap()
    dropKey('tb_vib', null)
    dropKey('tb_pad', null)
    app.setVib(true)
    app.setPad(0, false)
    this.sync()
  },

  back() { this.$app.$def.tap(); router.back() }
}
</script>

<style>
  @import '../../common/style/base.css';
  .gap { width: 100%; height: 14px; }
  .card { width: 100%; flex-direction: column; flex-shrink: 0; background-color: #262626; border-radius: 14px; padding: 10px 12px; margin-bottom: 8px; }
  .out { color: #d6d6d6; width: 100%; }
</style>
