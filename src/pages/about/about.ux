<template>
  <div class="page" style="padding-top: {{padTop}}px; padding-bottom: {{padBottom}}px; padding-left: {{padSide}}px; padding-right: {{padSide}}px">
    <scroll class="scroll" scroll-y="true" bounces="true">
      <div class="toptitle">
        <text class="t-title" style="font-size: {{fsTitle}}px">关于</text>
      </div>
      <div class="topnav">
        <text class="t-nav t-icon" @click="back">‹ 返回</text>
      </div>

      <div class="row">
        <div class="row-main">
          <text class="row-title" style="font-size: 17px">工具箱 {{version}}</text>
          <text class="row-sub" style="font-size: 12px">手环 10 端 · 屏幕 {{screenLine}}</text>
        </div>
      </div>

      <text class="sec" style="font-size: 12px">功能</text>
      <div class="row" for="{{features}}" tid="f">
        <div class="row-main">
          <text class="row-title" style="font-size: 15px">{{$item.k}}</text>
          <text class="row-sub" style="font-size: 12px">{{$item.v}}</text>
        </div>
      </div>

      <text class="sec" style="font-size: 12px">后端</text>
      <div class="row">
        <div class="row-main">
          <text class="row-title" style="font-size: 15px">{{beText}}</text>
          <text class="row-sub" style="font-size: 12px">{{beSub}}</text>
        </div>
      </div>

      <text class="sec" style="font-size: 12px">来源与许可</text>
      <div class="row">
        <div class="row-main">
          <text class="row-sub" style="font-size: 12px">界面端按协议重写；表盘位 Lua 后端照 Shell++ 的协议独立重写，并在本工程中按手环 10 适配。Shell++（com.shell.liangyi）作者 IKUN_CXKPRO（米坛），在此致谢。本工程代码 MIT，作者 模糊二维码byxz。</text>
        </div>
      </div>
      <div class="gap"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import bridge from '../../common/core/bridge'

export default {
  private: {
    padTop: 0,
    padBottom: 0,
    padSide: 0,
    fsTitle: 17,
    version: 'v0.1.0',
    beText: '检测中…',
    beSub: '表盘位 Lua 后端（终端/文件/监控等要靠它）',
    screenLine: '',
    features: [
      { k: '终端', v: '自己敲命令执行；命令历史与脚本' },
      { k: '监控 · 更多工具', v: 'CPU 负载、内存分池、进程列表、算力跑分与历史' },
      { k: '文件', v: '浏览、看文本与十六进制、就地编辑、递归找内容' },
      { k: '存储分析', v: '各应用占用排行、详情，可导出清单' },
      { k: '本机信息', v: '内核 / 内存池 / 分区表 / 挂载 / df 一页看全' },
      { k: '系统管家', v: '内存·CPU·进程体检与处理建议（只提示，不替你动手）' },
      { k: '应用管理 · 系统属性', v: '隐藏 / 恢复 / 删除应用，改 getprop（都要二次确认）' },
      { k: '后端诊断 · 日志', v: '六步通信自检与后端日志回读' },
      { k: '设置 · 关于', v: '按键振动、界面留白（三档）、导出配置与用法' }
    ]
  },

  onShow() {
    const app = this.$app.$def
    this.padTop = app.padTop
    this.padBottom = app.padBottom
    this.padSide = app.padSide
    this.fsTitle = app.fsTitle
    this.screenLine = app.screenLine()
    this.checkBackend()
  },

  /** 后端（表盘位的 Lua 应用）在不在：不在线时后面的终端/文件/监控页只能用应用自己的接口 */
  checkBackend() {
    const self = this
    bridge.status(function (r) {
      if (r.online) {
        self.beText = '后端在线'
        self.beSub = '目录 ' + r.dir
      } else {
        self.beText = '后端未就绪'
        self.beSub = r.why + '（需把 Lua 后端装到表盘位）'
      }
    })
  },

  back() { this.$app.$def.tap(); router.back() }
}
</script>

<style>
  @import '../../common/style/base.css';
  .gap { width: 100%; height: 14px; }
</style>
