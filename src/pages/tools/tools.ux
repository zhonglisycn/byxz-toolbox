<template>
  <div class="page" style="padding-top: {{padTop}}px; padding-bottom: {{padBottom}}px; padding-left: {{padSide}}px; padding-right: {{padSide}}px">
    <scroll class="scroll" scroll-y="true" bounces="true">
      <div class="toptitle">
        <text class="t-title" style="font-size: {{fsTitle}}px">更多工具</text>
      </div>
      <div class="topnav">
        <text class="t-nav t-icon" @click="back">‹ 返回</text>
      </div>

      <div class="row" @click="proc">
        <div class="row-main">
          <text class="row-title" style="font-size: 16px">进程列表</text>
          <text class="row-sub" style="font-size: 12px">读 /proc，按内存排序</text>
        </div>
        <text class="row-go t-icon">›</text>
      </div>
      <div class="row" @click="bench">
        <div class="row-main">
          <text class="row-title" style="font-size: 16px">算力跑分</text>
          <text class="row-sub" style="font-size: 12px">Lua 浮点循环 40 万次</text>
        </div>
        <text class="row-go t-icon">›</text>
      </div>
      <div class="row" @click="shot">
        <div class="row-main">
          <text class="row-title" style="font-size: 16px">截屏（帧缓冲）</text>
          <text class="row-sub" style="font-size: 12px">dd 读 /dev/fb0，参数待标定</text>
        </div>
        <text class="row-go t-icon">›</text>
      </div>

      <text class="sec" style="font-size: 12px">{{state}}</text>

      <div class="row" for="{{procRows}}" tid="p" @click="askKill($item)">
        <div class="row-main">
          <text class="row-title" style="font-size: 14px">{{$item.name}}　#{{$item.pid}}</text>
          <text class="row-sub" style="font-size: 11px">{{$item.line}}</text>
        </div>
        <text class="row-go t-icon">›</text>
      </div>
      <div class="card" if="{{killTarget}}">
        <text class="head" style="font-size: 12px">{{killHint}}</text>
        <div class="pill" style="background-color: #ff453a" @click="doKill">
          <text class="t-pill" style="font-size: 15px">再点一次：结束 {{killTarget.name}} #{{killTarget.pid}}</text>
        </div>
        <div class="pill pill-quiet" @click="cancelKill">
          <text class="t-pill" style="font-size: 15px">取消</text>
        </div>
      </div>

      <div class="card" if="{{benchHist.length}}">
        <text class="head" style="font-size: 12px">历次跑分（越高越快，最新在右）</text>
        <div class="chart">
          <div class="col" for="{{benchHist}}" tid="b" style="height: {{$item.hp}}px"></div>
        </div>
      </div>
      <div class="card" if="{{out}}">
        <text class="out" style="font-size: 12px">{{out}}</text>
      </div>
      <div class="gap"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import bridge from '../../common/core/bridge'
import { saveKey, loadKey } from '../../common/core/util'

export default {
  private: {
    padTop: 0, padBottom: 0, padSide: 0, fsTitle: 17, fsNav: 16,
    state: '点上面三项试试', out: '',
    benchHist: [],
    procRows: [], killTarget: null, killHint: ''
  },

  onShow() {
    const app = this.$app.$def
    this.padTop = app.padTop; this.padBottom = app.padBottom; this.padSide = app.padSide
    this.fsTitle = app.fsTitle; this.fsNav = app.fsNav
    const self = this
    loadKey('tb_bench', function (ok, v) { self.benchHist = ok && v ? JSON.parse(v) : [] })
  },

  proc() {
    this.$app.$def.tap()
    const self = this
    this.state = '读进程列表…'
    this.out = ''
    bridge.call('proc', { action: 'list', limit: 24 }, function (err, res) {
      if (err) { self.state = '✗ ' + err; return }
      if (!res || res.status !== 'ok') { self.state = '✗ ' + ((res && res.message) || '读不到'); return }
      const lines = []
      const items = res.items || []
      const rows = []
      for (let i = 0; i < items.length; i++) {
        const it = items[i]
        // NuttX 给的是栈用量，不是内存 RSS —— 老实按栈显示
        const st = it.stackBytes ? (it.stackBytes + 'B') : '?'
        const us = it.usedBytes ? (it.usedBytes + 'B') : '?'
        const fl = (it.filled === undefined || it.filled === null) ? '?' : (it.filled + '%')
        const cpu = (it.cpu === undefined || it.cpu === null) ? '' : (' · CPU ' + it.cpu + '%')
        const line = '栈 ' + st + ' / 用 ' + us + '（' + fl + '）' + cpu
        rows.push({ pid: it.pid, name: it.name || '?', line: line })
        lines.push(line + '  ' + (it.name || '?') + ' #' + it.pid)
      }
      self.procRows = rows
      self.killTarget = null
      self.state = '✓ ' + items.length + ' 个进程（按内存）'
      self.out = lines.join('\n')
    })
  },

  /* ---------- 进程：只能结束，改优先级做不到（NuttX 的 shell 没有对应命令） ---------- */
  askKill(it) {
    this.$app.$def.tap()
    this.killTarget = it
    this.killHint = '系统任务被结束可能导致手环重启（重启即恢复）。' + it.name + ' 的栈用量 ' + it.line
  },

  cancelKill() {
    this.$app.$def.tap()
    this.killTarget = null
  },

  doKill() {
    const self = this
    const app = this.$app.$def
    app.tap()
    if (!this.killTarget) return
    const pid = this.killTarget.pid
    bridge.call('proc', { action: 'kill', pid: pid, confirm: true }, function (err, res) {
      if (err) { self.state = '✗ ' + err; return }
      if (!res || res.status !== 'ok') { self.state = '✗ ' + ((res && res.message) || '结束不了'); return }
      self.state = '✓ ' + ((res && res.message) || ('已发送 kill ' + pid))
      self.killTarget = null
      self.proc()          // 立刻刷一遍看还在不在
    })
  },

  bench() {
    this.$app.$def.tap()
    const self = this
    this.state = '跑分中…'
    this.out = ''
    bridge.call('bench', { rounds: 400000 }, function (err, res) {
      if (err) { self.state = '✗ ' + err; return }
      if (!res || res.status !== 'ok') { self.state = '✗ ' + ((res && res.message) || '跑不了'); return }
      self.state = '✓ ' + res.rounds + ' 次 / ' + (res.seconds || 0) + ' 秒'
      self.out = '速度 ' + res.kops + ' 千次每秒\n结果校验 ' + res.checksum
      // 存历史并算柱高（越高越快）
      const h = self.benchHist.concat([{ k: res.kops }]).slice(-18)
      const max = h.reduce(function (a, b) { return Math.max(a, Number(b.k) || 0) }, 1)
      self.benchHist = h.map(function (it) {
        return { k: it.k, hp: Math.max(4, Math.round((Number(it.k) || 0) * 56 / max)) }
      })
      saveKey('tb_bench', JSON.stringify(self.benchHist), null)
    })
  },

  shot() {
    this.$app.$def.tap()
    const self = this
    this.state = '抓帧缓冲…'
    this.out = ''
    bridge.screenshot('', function (err, res) {
      if (err) { self.state = '✗ ' + err; return }
      self.state = (res && res.status === 'ok') ? '✓ 抓到了' : '✗ 需要标定'
      self.out = '字节 ' + ((res && res.bytes) || 0) + ' / 预期 ' + ((res && res.expectBytes) || 0)
        + '\nstride ' + ((res && res.strideBytes) || 0) + '  skip ' + ((res && res.skipRows) || 0)
        + '  bpp ' + ((res && res.bpp) || 0) + '\n' + ((res && res.message) || '')
    })
  },

  back() { this.$app.$def.tap(); router.back() }
}
</script>

<style>
  @import '../../common/style/base.css';
  .card { width: 100%; flex-direction: column; flex-shrink: 0; background-color: #262626; border-radius: 14px; padding: 10px 12px; margin-bottom: 8px; }
  .out { color: #d6d6d6; width: 100%; }
  .head { color: #8e8e93; width: 100%; margin-bottom: 6px; }
  .chart { width: 100%; height: 60px; flex-direction: row; align-items: flex-end; }
  .col { width: 8px; margin-right: 3px; background-color: #0d84ff; border-radius: 2px; flex-shrink: 0; }
  .gap { width: 100%; height: 14px; }
</style>
